<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="146dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <!-- FOTO DEL PRODUCTO -->
    <ImageView
        android:id="@+id/iv_foto_producto_3"
        android:layout_width="146dp"
        android:layout_height="197dp"
        android:scaleType="centerCrop"
        android:src="@drawable/iv_foto_producto_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN FAVORITO SUPERPUESTO EN LA ESQUINA SUPERIOR DERECHA -->
    <ImageButton
        android:id="@+id/btn_favorito"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_favorito"
        app:layout_constraintTop_toTopOf="@id/iv_foto_producto_3"
        app:layout_constraintEnd_toEndOf="@id/iv_foto_producto_3"
        android:contentDescription="Favorito"/>

    <!-- NOMBRE DEL PRODUCTO -->
    <TextView
        android:id="@+id/tv_nombre_producto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nombre_prod_3"
        android:textColor="@color/texto_principal"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/iv_foto_producto_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PRECIO -->
    <TextView
        android:id="@+id/tv_precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/precio_prod_3"
        android:textColor="@color/texto_precio"
        android:fontFamily="@font/hepta_slab"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_nombre_producto"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>